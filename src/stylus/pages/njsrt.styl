.main-inner:has(.njsrt)
  background url("/img/overlays/njsrt.png")

.content:has(.njsrt) .content-outer
  color njsrt

.njsrt
  position relative
  h1,h2,h3
    font-family "Eurostile", "sans-serif"
    letter-spacing -0.05em
    color lite
  h3
    margin-bottom 0
  a
    color njsrt
    &::before
      background-color njsrt !important
  .comment
    color neutral-1
  .action
    font-family "Eurostile", "sans-serif"
    background-color njsrt
    border-color njsrt
    color dark
    padding 0
    span
      margin-bottom -6px
    &-icon
      color dark
      margin-left 2px
      margin-top -12px
    &:hover
      color njsrt
      background-color dark
      .action-icon
        color njsrt
  &-section
    font-size 16px
    padding 16px
    color lite
    background-color mix(njsrt, dark)
    border-radius 4px
    margin-bottom 24px
  &-text
    color lite
  .upsell
    &-nw, &-ne, &-sw, &-se
      border-color njsrt
  .credits p,
  .credits li
  .credits li::before
    color lite
  &-char
    background-image url("/img/itg/sprites/val.png")
    width 128px
    height 256px
    position absolute
    bottom 32px
    right 32px
    animation valSprite 0.6s steps(3) infinite, float 4s ease-in-out infinite

@keyframes valSprite
  0%
    background-position 512px
  100%
    background-position 128px

.greeble-njsrt
  mono(16px, njsrt)
  align-self center
  text-align center
  margin 16px 0
  letter-spacing 16px
  user-select none