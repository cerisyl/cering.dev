.itg
  flex(column, nowrap, gap: 8px)
  &-small
    flex(column, nowrap, gap: 4px)
  &-logo
    margin-top 16px
    width 620px
    height auto
  &-embed
    width 100%
    border-radius 4px
    aspect-ratio 16/9
    &-mods
      @extends .itg-embed
      aspect-ratio 4/3

.upsell
  width 272px
  border-radius 4px
  border 3px solid neutral
  margin 8px 16px 8px 16px
  &-nw
    @extends .upsell
    float left
    transform perspective(80px) rotateX(-2deg) rotateY(3deg)
  &-ne
    @extends .upsell
    float right
    transform perspective(80px) rotateX(-2deg) rotateY(-3deg)
  &-sw
    @extends .upsell
    float left
    transform perspective(80px) rotateX(2deg) rotateY(3deg)
  &-se
    @extends .upsell
    float right
    transform perspective(80px) rotateX(2deg) rotateY(-3deg)

.credits
  &-section
    margin 0 0 16px 16px
    p
      margin-bottom 0
    li
      color lite
  &-spacer
    display inline-block
    width 212px