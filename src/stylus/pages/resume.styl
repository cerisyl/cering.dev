.resume
  flex(row, nowrap)
  margin-top 8px
  &-h1
    text-align center
    margin-bottom 0
  &-h2
    color accent
    margin-bottom -4px
  &-h3
    margin-bottom 0
  &-top
    flex(column-reverse, nowrap, center, center)
    &-links
      flex(row, nowrap, center, gap: 32px)
  &-sub
    text(16px, dark, bold, italic)
    text-align center
  &-l
    flex(column, nowrap, stretch, stretch)
    text-align right
    min-width 20%
    max-width 180px
    padding-right 12px
    &-group
      flex(row, wrap, right, start)
    &-section
      //background-color neutral
      border-radius 4px
      min-width 100%
      max-width 100%
      padding 8px 0
      p
        margin-bottom 2px
        line-height 16px
        text-align right
  &-comment
    text(11px, neutral-2, bold, italic)
    margin-top -4px
    margin-bottom 0 !important
  &-updated
    margin-top auto
    p
      line-height 16px
      text-align right
  &-r
    border-left 1px solid accent
    padding-left 8px
    &-section
      flex(column, nowrap)
      border-left 4px solid main-mid
      padding 8px
      border-radius 4px
      ul
        margin-bottom 0
      li
        line-height 12px
        margin-bottom 8px
        margin-left 1em
        text-indent -1em
      &-intro
        background-color neutral
    &-h3
      text-transform lowercase
      margin-bottom -4px
  &-date
    text(12px, neutral-2, bold, italic)
    margin-bottom -4px