.main-inner:has(.misfits)
  background url("/img/overlays/misfits.png")

.content:has(.misfits) .content-outer
  color misfits

.misfits
  position relative
  h1,h2,h3
    font-family "Serpentine", sans-serif
    color lite
    text-shadow 3px 3px misfits-alt
  h3
    margin-bottom 4px
  a
    color misfits
    &::before
      background-color misfits !important
  .credits a
    color misfits-alt
    &::before
      background-color misfits-alt !important
  .comment
    color neutral-1
  .action
    font-family "Serpentine", sans-serif
    color dark
    background-color misfits
    border-color misfits
    padding 0
    span
      margin-bottom -4px
    &-icon
      color dark
      margin-left 2px
      margin-top -12px
    &:hover
      color misfits
      background-color misfits-alt
      .action-icon
        color misfits
  &-section
    font-size 16px
    padding 16px
    color dark
    background-color mix(misfits, lite)
    border-radius 4px
    margin-bottom 24px
  &-text
    color lite
  .upsell
    &-nw, &-ne, &-sw, &-se
      border-color misfits
  &-char
    background-image url("/img/itg/sprites/val.png")
    width 128px
    height 256px
    position absolute
    bottom 32px
    right 32px
    animation valSprite 0.6s steps(3) infinite, float 4s ease-in-out infinite

@keyframes valSprite
  0%
    background-position 512px
  100%
    background-position 128px