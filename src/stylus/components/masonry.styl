.masonry
  &-object
    display block
    position relative
    line-height 0
    border-radius 4px
    cursor pointer
  &-img
    width 100%
    border-radius 4px
  &-object:hover .masonry-info
    opacity 1
  &-info
    flex(column, nowrap, center, center)
    position absolute
    width 100%
    height 100%
    top 0
    left 0
    background-color rgba(#000, 0.75)
    backdrop-filter blur(3px)
    border-radius 3px
    padding 8px
    pointer-events none
    opacity 0
    animate(opacity)
    border 1px solid accent
    &-main
      text(16px, lite)
      margin-bottom 0
      text-align center
    &-title
      font-weight bold
      font-style italic
    &-desc
      text(12px, neutral)
      margin-bottom 0
      text-align center