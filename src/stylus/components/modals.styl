modal-box()
  z-index 2
  background-color lite
  text(16px, dark)
  border 1px solid dark
  border-radius 4px
  margin-bottom 0

.modal
  position fixed
  overflow hidden
  overscroll-behavior contain
  top 0
  left 0
  width 100%
  height 100%
  background-color alpha(dark, 0.85)
  z-index 30
  flex(column, nowrap, center, center, gap: 16px)
  &-hidden
    position absolute
    overflow visible
    overscroll-behavior auto
    opacity 0
    visibility hidden
  &-image
    max-width 83.33%
    max-height 83.33%
    aspect-ratio keep
    background-color neutral
    padding 24px
    border-radius 8px
    box-shadow 0px 0px 20px dark
    z-index 1
  &-index
    modal-box()
    padding 6px 16px
  &-caption
    modal-box()
    padding 8px 24px