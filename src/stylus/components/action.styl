action()
  flex(align: center, x-align: center)
  text-align center
  background-color accent
  helv(26px, lite)
  font-size 26px
  user-select none
  position relative
  padding 4px 12px
  border-radius 4px
  border 1px solid accent
  span
    position relative
    margin-bottom -14px
  &-icon
    mono(18px, lite)
    margin-left 6px
    margin-right -12px
    margin-top -20px
    text-align center

.action
  action()
  &:hover
    color accent
    background-color lite
    .action-icon
      color accent
  &-off
    action()
    background-color neutral
    cursor default
    border-color neutral
    color neutral-1
    .action-icon
      color neutral-1

.actions
  &-side
    flex(column, nowrap, center, stretch, 8px)
    margin-bottom 16px
  &-right
    flex(column, nowrap, right, end)
    margin-bottom 16px